# Copy to .env and adjust. No variable here is a secret by default; never commit .env.
# All are optional: config.yaml holds the defaults.

# Where approved/candidate models live (registry.json + versions/)
SVD_MODEL_DIR=models
# Dataset location (downloaded and checksum-verified on first run)
SVD_DATA_DIR=data
# Monitoring event log directory and pseudonymisation salt for user ids
SVD_MONITORING_DIR=monitoring
SVD_MONITORING_SALT=change-me-to-a-random-string
# Where the API appends POST /feedback ratings (consumed by src/retrain.py)
SVD_FEEDBACK_PATH=data/feedback/api_feedback.csv
# MLflow: local SQLite file by default; set to http://mlflow:5000 for the compose server
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
SVD_MLFLOW_ENABLED=true
# Logging: json (default in the API) or text
LOG_FORMAT=json
SVD_LOG_LEVEL=INFO
# Enables POST /model/reload when set (send it as the X-Admin-Token header)
SVD_ADMIN_TOKEN=
# Host port for docker compose
API_PORT=8000
